#cloud-config
package_update: true
package_upgrade: true
packages:
  - curl
  - ufw
runcmd:
  # Tailscale: la VM se une a la red privada con el tag de pruebas y SSH de Tailscale.
  - curl -fsSL https://tailscale.com/install.sh | sh
  - tailscale up --authkey=${tailscale_authkey} --hostname=trayecta-go-pruebas --ssh --advertise-tags=tag:trayecta-pruebas
  # Firewall del sistema: solo web pública; todo lo demás solo por Tailscale.
  - ufw default deny incoming
  - ufw default allow outgoing
  - ufw allow 80/tcp
  - ufw allow 443/tcp
  - ufw allow 41641/udp
  - ufw allow in on tailscale0
  - ufw --force enable
  # Las imágenes de Ubuntu en Oracle traen reglas de iptables propias; se reconcilian en el playbook de Ansible.
