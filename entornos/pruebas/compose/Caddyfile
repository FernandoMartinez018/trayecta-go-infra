	email {$CORREO_CERTIFICADOS}
}

api.{$DOMINIO} {
	encode zstd gzip
	reverse_proxy backend:8080
}

auth.{$DOMINIO} {
	# La consola de administración y el realm master de Keycloak no se exponen a internet; se usan por Tailscale.
	@admin path /admin* /realms/master*
	respond @admin 404
	reverse_proxy keycloak:8080
}
