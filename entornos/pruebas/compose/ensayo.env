# Valores ficticios del ensayo local (compose.ensayo.yaml): no son secretos y no sirven en ningún entorno real.
# El nombre no coincide con el `.env.*` del .gitignore, así que se versiona.
# Todos los accesos salen de una sola cadena de ensayo, para que los escáneres de secretos no confundan
# estas contraseñas ficticias con credenciales reales.

VALOR_DE_ENSAYO=ensayo

IMAGEN_BACKEND=trayecta-go-backend:local
IMAGEN_KEYCLOAK=trayecta-go-keycloak:local

DOMINIO=localhost
URL_AUTH=https://auth.localhost
CORREO_CERTIFICADOS=ensayo@trayecta.test

POSTGRES_PASSWORD=${VALOR_DE_ENSAYO}
KEYCLOAK_ADMIN_PASSWORD=${VALOR_DE_ENSAYO}
KEYCLOAK_DB_PASSWORD=${VALOR_DE_ENSAYO}

# Google no se prueba en el ensayo: el realm solo necesita que las variables existan.
GOOGLE_CLIENT_ID=ensayo-google-id
GOOGLE_CLIENT_SECRET=${VALOR_DE_ENSAYO}

# Correo a Mailpit, sin autenticación ni STARTTLS.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_AUTH=false
SMTP_STARTTLS=false
SMTP_USER=no-responder@trayecta.test
SMTP_PASSWORD=${VALOR_DE_ENSAYO}

# S3 local (versitygw) en lugar de Object Storage de Oracle; versitygw solo acepta la región us-east-1.
OCI_NAMESPACE=ensayo
OCI_REGION=us-east-1
OCI_S3_ACCESS_KEY=ensayo-acceso
OCI_S3_SECRET_KEY=${VALOR_DE_ENSAYO}
S3_ENDPOINT=http://s3-local:7070
